{
  "name": "rasterize",
  "main": "worker.js",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "r-cf.spicydevs.xyz",
      "zone_name": "spicydevs.xyz",
      "custom_domain": true,
    },
  ],
  // KV namespace for ALL fleet state: Discord dashboard message ID, the fleet
  // snapshot (fleet:snapshot), alert rate-limit meta (fleet:meta), legacy
  // serverless self-report beacons (fleet:heartbeat:<node>). Populated by
  // lib/fleetSync.js on the 15-minute cron; read by lib/health.js's bridge
  // per request (5s per-isolate cache) and by lib/dashboard.js.
  // Create with: wrangler kv:namespace create DASHBOARD_KV
  // Then replace the id below with the output ID.
  "kv_namespaces": [
    { "binding": "DASHBOARD_KV", "id": "c0547489012a48368146b53c1227f1f2" },
  ],

  "analytics_engine_datasets": [
    {
      // Rasterizer node performance metrics (existing)
      "binding": "RASTER_METRICS",
      "dataset": "raster_metrics",
    },
    {
      // Per-request analytics including edge cache hits (new in v2)
      // Written by worker.js for every HTTP request, including cache hits.
      // Enables queries like "top 50 most requested IMDb IDs this week".
      "binding": "REQUEST_ANALYTICS",
      "dataset": "request_analytics",
    },
  ],
  // Cron: every 15 minutes. fleetSync.js queries RASTER_METRICS (Analytics
  // Engine SQL API), health-polls stale nodes, computes the fleet snapshot
  // into DASHBOARD_KV, fires alerts and refreshes the Discord dashboard.
  "triggers": {
    "crons": ["*/15 * * * *"],
  },

  // FleetHealth Durable Object removed — all fleet state lives in
  // DASHBOARD_KV (see lib/fleetSync.js). The deletion migration below
  // permanently drops the DO's SQLite data on deploy.
  "durable_objects": {
    "bindings": [],
  },
  "migrations": [{ "tag": "v2", "deleted_classes": ["FleetHealth"] }],
  // Node URLs — set real values with: wrangler vars set KEY value
  // Or set in the Cloudflare dashboard under Workers > Settings > Variables.
  // DISCORD_WEBHOOK_URL must be set as a secret:
  //   wrangler secret put DISCORD_WEBHOOK_URL
  // AFTER — separate alerts webhook so a flapping node during a real incident
  // doesn't bury the hourly dashboard channel. Set the real webhook URL via
  // `wrangler secret put ALERTS_WEBHOOK_URL` — left as a var placeholder here
  // since I don't have a real URL to put; swap to secrets_store_secrets if
  // preferred, matching CF_ACCOUNT_ID/CF_API_TOKEN's pattern in the main
  // wrangler.jsonc.
  "vars": {
    "VERCEL_NODE_URL": "https://us-r-vercel.vercel.app",
    "NETLIFY_NODE_URL": "https://r-netlify.netlify.app",
    "RENDER_NODE_URL": "https://euc-r-render.onrender.com",
    "VPS1_NODE_URL": "http://node-3.midas.host:25108",
    "VPS2_NODE_URL": "http://de20.spaceify.eu:26100",
    "VPS3_NODE_URL": "http://fr1.spaceify.eu:25980/",
    "DISCORD_WEBHOOK_URL": "https://discord.com/api/webhooks/1522125033227550771/pFI__NgmhoZeiy9XyyCWi1RMkWd2IKBDOkepkj7qpSQBXDaVwyNANVpyfL8IDMDjG1nW",
    "ALERTS_WEBHOOK_URL": "https://discord.com/api/webhooks/1485865094695878800/a6_LaS5R6J6mbZXWvsMG6PTz9N0He5oG2yqsPWqs-olF5jmHMq0yuDYJ69n5zIdqnpGB",
  },
  // Fleet sync queries the Analytics Engine SQL API from inside the Worker
  // (the only in-Worker path — there is no binding-level query API), so the
  // same Secrets Store bindings as backend require those credentials:
  "secrets_store_secrets": [
    {
      "binding": "CF_ACCOUNT_ID",
      "store_id": "9b4aa7fc14e74938a057ff9e3fbf4d4d",
      "secret_name": "CF_ACCOUNT_ID",
    },
    {
      "binding": "CF_API_TOKEN",
      "store_id": "9b4aa7fc14e74938a057ff9e3fbf4d4d",
      "secret_name": "CF_API_TOKEN",
    },
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
